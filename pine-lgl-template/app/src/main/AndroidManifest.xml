<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- android:name points at HookApp, so our code runs before any activity.
         That is the same slot the loader occupies — here it is just normal
         app code rather than an injected class. -->
    <application
        android:name=".HookApp"
        android:allowBackup="false"
        android:label="Hook Template">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
